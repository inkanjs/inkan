{
  "name": "@vxnsin/inkan",
  "version": "0.3.0",
  "description": "An API server for Node where the docs can't lie: one contract per route gives you validation, types, OpenAPI, docs and tests.",
  "keywords": [
    "api",
    "server",
    "http",
    "framework",
    "openapi",
    "validation",
    "contract",
    "typescript",
    "express",
    "fastapi"
  ],
  "license": "MIT",
  "author": "Vensin (https://github.com/vxnsin)",
  "homepage": "https://github.com/inkanjs/inkan#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inkanjs/inkan.git"
  },
  "bugs": "https://github.com/inkanjs/inkan/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "inkan": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "assets/logo.svg"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "check:example": "node src/cli.ts check examples/shop.ts",
    "dev:example": "node --watch examples/shop.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
